rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 従来の個人用データ。トップ画像は引き続き本人専用。
    match /users/{userId}/{subcollection}/{documentId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && (subcollection == 'entries' || subcollection == 'media');
    }
    match /families/{familyId} {
      function signedIn() { return request.auth != null; }
      function isMember() { return signedIn() &&
        (resource.data.ownerUid == request.auth.uid || resource.data.spouseUid == request.auth.uid); }
      allow get: if signedIn() && (request.auth.uid == familyId ||
        (resource != null && resource.data.spouseUid == request.auth.uid));
      allow list: if false;
      allow create: if signedIn() && familyId == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid','spouseUid','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.spouseUid is string
        && request.resource.data.spouseUid.size() >= 10
        && request.resource.data.spouseUid != request.auth.uid;
      allow update, delete: if false;
      match /{subcollection}/{documentId} {
        function allowed() {return request.auth != null &&
          exists(/databases/$(database)/documents/families/$(familyId)) &&
          (get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid ||
           get(/databases/$(database)/documents/families/$(familyId)).data.spouseUid == request.auth.uid) &&
          (subcollection == 'entries' || subcollection == 'media');}
        allow read, write: if allowed();
      }
    }
  }
}
